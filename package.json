{
  "name": "notion-help-center",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-sync": "pnpm run sync && next build",
    "start": "next start",
    "sync": "tsx scripts/sync-notion.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "build:widget": "cd widget && pnpm install && pnpm build && cp dist/widget.iife.global.js ../public/widget.js && npm pack --pack-destination ../public && cd ../public && mv notion-help-center-widget-*.tgz widget.tgz",
    "dev:widget": "cd widget && pnpm install && pnpm dev"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "better-sqlite3": "^12.6.2",
    "lunr": "^2.3.9",
    "next": "^14.2.33",
    "next-seo": "^5.15.0",
    "node-cron": "^4.2.1",
    "notion-to-md": "^3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lunr": "^2.3.5",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.7",
    "dotenv": "^16.4.5",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
